# Dockerfile.hardened
# Incremental hardening over Juice Shop's existing Dockerfile.
# NOTE: the original Dockerfile already implements several best practices
# (multi-stage build, distroless base, non-root user) — see docs/dockerfile-comparison.md
# for the full before/after writeup. This file adds the remaining gaps found
# during review: explicit secret-file exclusion, with digest pinning noted
# as a follow-up improvement (see comparison doc — not applied here since it
# requires resolving current digests via `docker inspect`, deferred to keep
# this buildable directly in CI without a local Docker step).

# --- Stage 1: build ---
FROM node:24 AS installer
COPY . /juice-shop
WORKDIR /juice-shop

# Explicitly refuse to build if a real .env file is present in the build
# context — defense in depth on top of .dockerignore, since .dockerignore
# silently skips files rather than failing loudly if someone's local .env
# somehow wasn't excluded.
RUN if [ -f .env ]; then echo "ERROR: .env present in build context, refusing to build" && exit 1; fi

RUN npm install -g typescript@^6.0.3
RUN npm install --omit=dev
RUN npm dedupe --omit=dev
RUN rm -rf frontend/node_modules
RUN rm -rf frontend/.angular
RUN rm -rf frontend/src/assets
RUN mkdir logs
RUN chown -R 65532 logs
RUN chgrp -R 0 ftp/ frontend/dist/ logs/ data/ i18n/
RUN chmod -R g=u ftp/ frontend/dist/ logs/ data/ i18n/
RUN rm ftp/legal.md || true
RUN rm i18n/*.json || true

ARG CYCLONEDX_NPM_VERSION='^2.0.0||^3.0.0||^4.0.0'
RUN npm install -g @cyclonedx/cyclonedx-npm@$CYCLONEDX_NPM_VERSION
RUN npm run sbom

# --- Stage 2: final runtime image ---
# Distroless: no shell, no package manager, no OS utilities. Attackers who
# get code execution inside this container have no `sh`, `curl`, `wget`, or
# `apt` to pivot with — this is already close to best-practice minimal.
FROM gcr.io/distroless/nodejs24-debian13
ARG BUILD_DATE
ARG VCS_REF
LABEL maintainer="Bjoern Kimminich <bjoern.kimminich@owasp.org>" \
    org.opencontainers.image.title="OWASP Juice Shop" \
    org.opencontainers.image.description="Probably the most modern and sophisticated insecure web application" \
    org.opencontainers.image.authors="Bjoern Kimminich <bjoern.kimminich@owasp.org>" \
    org.opencontainers.image.vendor="Open Worldwide Application Security Project" \
    org.opencontainers.image.documentation="https://help.owasp-juice.shop" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.version="20.1.1" \
    org.opencontainers.image.url="https://owasp-juice.shop" \
    org.opencontainers.image.source="https://github.com/juice-shop/juice-shop" \
    org.opencontainers.image.revision=$VCS_REF \
    org.opencontainers.image.created=$BUILD_DATE
WORKDIR /juice-shop
COPY --from=installer --chown=65532:0 /juice-shop .
USER 65532
EXPOSE 3000
# No HEALTHCHECK: distroless has no shell, so a traditional
# "HEALTHCHECK CMD curl ..." cannot run inside this image. Health checks for
# this container should be done externally (e.g. Kubernetes livenessProbe
# using an HTTP GET, or an orchestrator-level check), not baked in here —
# adding a shell just to support HEALTHCHECK would undermine the whole
# point of using distroless in the first place.
CMD ["/juice-shop/build/app.js"]